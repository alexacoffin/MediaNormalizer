MEDIA_NORMALIZER_PORT=18081

# Existing host directories to bind into the container.
MEDIA_LIBRARY_PATH=./data/library
MEDIA_NORMALIZED_PATH=./data/normalized

# Required by OMDb-backed TV normalization.
OMDB_API_KEY=replace-with-your-omdb-api-key

# Keep false until the mounted paths and configuration are verified.
MEDIA_LIBRARY_TV_ENABLED=false
